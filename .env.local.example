# Formspree — create a form at https://formspree.io and paste its ID here.
# The contact form posts directly to https://formspree.io/f/<FORM_ID>.
NEXT_PUBLIC_FORMSPREE_ID=xxxxxxxx

# Brevo (Sendinblue) — for the newsletter signup.
# Create an API key: Brevo dashboard → SMTP & API → API keys.
# Create a contact list and put its numeric ID here.
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_LIST_ID=2
